# Standalone runtime; export before launch (.NET does not load .env automatically).
# Compose uses the root env files instead.

# Runtime (Dockerfile defaults; Development enables Swagger)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Http__RedirectToHttps=false

# Database (required; do not also set Database__ConnectionString)
Database__Server=localhost,1433
Database__Name=JapaneseLearningUser
Database__User=sa
Database__Password=
Database__TrustServerCertificate=true

# JWT (HTTP JWKS is for local development only)
Jwt__Issuer=JapaneseLearning.User
Jwt__Audience=JapaneseLearning
Jwt__JwksUrl=http://localhost:8083/api/v1/jwks/user
Jwt__RequireHttpsMetadata=false
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Signing (required; use local paths outside Docker)
APP_SECURITY_SIGNING_KEYS_0_KID=jp-user-1
APP_SECURITY_SIGNING_KEYS_0_PRIVATE_KEY_PATH=
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=true
# Add contiguous indices for rotation; exactly one key must be active.

# Logging (application defaults; Compose uses /app/logs)
Logging__SlowRequestThresholdMilliseconds=1000
LogFiles__Directory=logs
LogFiles__RetentionDays=30
LogFiles__FileSizeLimitBytes=104857600
LogFiles__RetainedFileCountLimit=300
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__JapaneseLearning.User=Information
AllowedHosts=*
