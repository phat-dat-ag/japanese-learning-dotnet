{
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "PrivateKeyPath": "",
    "PublicKeyPath": "",
    "KeyId": "",
    "Issuer": "JapaneseLearning.User",
    "Audience": "JapaneseLearning",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "JapaneseLearning.User": "Information",
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "LogFiles": {
    "Directory": "logs",
    "RetentionDays": 30,
    "FileSizeLimitBytes": 104857600,
    "RetainedFileCountLimit": 300
  },
  "AllowedHosts": "*"
}